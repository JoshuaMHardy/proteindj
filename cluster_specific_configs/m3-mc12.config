params {
    rfd_models = '/fs04/scratch2/mc12/oldscratch/proteindj/models/rfd'
    rfd4_models = '/fs04/scratch2/mc12/oldscratch/proteindj/models/rfd4'
    mpnn_models = '/fs04/scratch2/mc12/oldscratch/proteindj/models/mpnn'
    af2_models = '/fs04/scratch2/mc12/oldscratch/proteindj/models/af2'
    boltz_models = '/fs04/scratch2/mc12/oldscratch/proteindj/models/boltz'
    bg_models = '/fs04/scratch2/mc12/oldscratch/proteindj/models/boltzgen'
    af2_jax_compilation_cache_dir = "${projectDir}/.af2_cache"
    gpu_model = 'A16'
    gpu_queue = 'ccemmp'
    gpus = 4
    cpus_per_gpu = 4
    cpus = 12
    zip_pdbs = false
}

conda.enabled = false
apptainer.enabled = false
docker.enabled = false

singularity {
    enabled = true
    autoMounts = true
    cacheDir = '/fs04/scratch2/mc12/oldscratch/proteindj/containers'
}

process {
    executor = 'slurm'
    clusterOptions = '--qos=ccemmpq --account=mc12'
    withLabel: gpu {
        clusterOptions = '--qos=ccemmpq --account=mc12 --gres=gpu:' + "${params.gpu_model}" + ':1'
    }
}
