/*
========================================================================================
    Nextflow config file for running tests
========================================================================================
*/

conda.enabled = false
apptainer.enabled = true
apptainer.autoMount = true
singularity.enabled = false
docker.enabled = false

profiles {
    // GitHub-hosted runner (4 vCPU / 16 GB, or 2 vCPU / 8 GB for private repos): the pipeline's
    // default 24 CPU / 24 GB request would never be schedulable by the local executor. The values
    // are set on `process` directly because nextflow.config interpolates params.cpus into
    // process.cpus at parse time, before a params override here could take effect.
    ci {
        // Nextflow 25.10 leaves apptainer.pullTimeout null when unset, which crashes image pulls
        apptainer.pullTimeout = '20 min'
        process {
            cpus = 2
            memory = '4GB'
        }
    }
}
