/*
========================================================================================
    Nextflow config file for running tests
========================================================================================
*/

conda.enabled = false
apptainer.enabled = true
apptainer.autoMount = true
singularity.enabled = false
docker.enabled = false

profiles {
    // GitHub-hosted runner (4 vCPU / 16 GB, or 2 vCPU / 8 GB for private repos): the
    // pipeline's default 24 CPU / 24 GB request would never be schedulable by the local executor.
    ci {
        params {
            cpus = 2
            memory_cpu = '4GB'
        }
    }
}
