/*
========================================================================================
    Nextflow config file for running tests
========================================================================================
*/

// Tier B (nf-test nextflow_process) tests run real containers locally against the .sif
// files already built at the repo root, rather than pulling from the oras registry.
conda.enabled = false
apptainer.enabled = true
apptainer.autoMount = true
singularity.enabled = false
docker.enabled = false

process {
    withLabel: python_tools {
        container = "${projectDir}/python_tools.sif"
    }
}
