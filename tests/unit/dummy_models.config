// Points every model directory at empty placeholder files so the pipeline's launch-time model
// validation passes in '-preview' runs without downloading the real (multi-GB) weights.
params {
    rfd_models = "${projectDir}/tests/fixtures/dummy_models/rfd"
    rfd4_models = "${projectDir}/tests/fixtures/dummy_models/rfd4"
    mpnn_models = "${projectDir}/tests/fixtures/dummy_models/mpnn"
    af2_models = "${projectDir}/tests/fixtures/dummy_models/af2"
    boltz_models = "${projectDir}/tests/fixtures/dummy_models/boltz"
    bg_models = "${projectDir}/tests/fixtures/dummy_models/boltzgen"
}
